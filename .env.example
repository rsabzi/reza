# Optional fallback. Preferred: enter and validate the key in Dashboard Settings.
# Leave blank to use all non-AI features and local embeddings.
GEMINI_API_KEY=

# auto = Gemini when a key exists, deterministic local vectors otherwise.
# Use gemini to require text-embedding-004, or local for fully offline operation.
EMBEDDING_BACKEND=auto

# One IANA timezone for this single-user installation.
AGENT_TIMEZONE=Asia/Tehran

# Relative SQLite path is resolved from the repository root.
DATABASE_URL=sqlite:///./agent_core.db
